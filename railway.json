{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "services": [
    {
      "name": "AsharExchangeMCP",
      "type": "web",
      "port": 3001,
      "cpu": 0.5,
      "memoryMB": 512,
      "minReplicas": 1,
      "maxReplicas": 2
    }
  ]
}
